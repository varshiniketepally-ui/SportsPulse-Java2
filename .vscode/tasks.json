{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build SportsPulse",
            "type": "shell",
            "windows": {
                "command": ".\\build.bat build"
            },
            "osx": {
                "command": "./build.sh build"
            },
            "linux": {
                "command": "./build.sh build"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Automated Tests",
            "type": "shell",
            "windows": {
                "command": ".\\build.bat test"
            },
            "osx": {
                "command": "./build.sh test"
            },
            "linux": {
                "command": "./build.sh test"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Package Standalone JAR",
            "type": "shell",
            "windows": {
                "command": ".\\build.bat jar"
            },
            "osx": {
                "command": "./build.sh jar"
            },
            "linux": {
                "command": "./build.sh jar"
            },
            "problemMatcher": []
        }
    ]
}
